# =============================================================================
# Dojo Ledger — Variables de entorno
# Copiá este archivo a `.env.local` y completá con tu proyecto de Supabase.
#   Supabase Dashboard → Project Settings → Data API / API Keys
# Sin estas variables, la app corre en "modo demo" (UI explorable, sin persistir).
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Opcional (Paso 6 / Auth): URL pública del sitio, usada como fallback para el
# link de confirmación de email cuando no se puede inferir el host del request.
# Ej.: http://localhost:3000  ó  https://tu-dominio.com
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

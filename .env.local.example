# =============================================================================
# Dojo Ledger — Variables de entorno
# Copiá este archivo a `.env.local` y completá con tu proyecto de Supabase.
#   Supabase Dashboard → Project Settings → Data API / API Keys
# Sin estas variables, la app corre en "modo demo" (UI explorable, sin persistir).
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La "anon key" (o su nuevo nombre en Supabase, "publishable key"). El código
# acepta cualquiera de los dos nombres de variable:
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Auto-login single-user (sin pantalla de login). Credenciales de la ÚNICA cuenta
# dedicada de la app. SÓLO servidor (sin prefijo NEXT_PUBLIC → no se exponen al
# navegador). La app inicia sesión sola con estas credenciales.
APP_AUTH_EMAIL=tu-cuenta@ejemplo.com
APP_AUTH_PASSWORD=una-clave-larga

# Opcional (Paso 6 / Auth): URL pública del sitio, usada como fallback para el
# link de confirmación de email cuando no se puede inferir el host del request.
# Ej.: http://localhost:3000  ó  https://tu-dominio.com
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
